{
  "name": "nexodesk-ai",
  "private": true,
  "version": "0.1.0",
  "description": "NexoDesk AI — plataforma inteligente de operação comercial",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "setup:node22": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-node.ps1",
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "dev:api": "pnpm --filter @nexodesk/api dev",
    "dev:web": "pnpm --filter @nexodesk/web dev",
    "build": "pnpm --filter @nexodesk/api build && pnpm --filter @nexodesk/web build",
    "start": "pnpm --filter @nexodesk/api start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @nexodesk/database generate",
    "db:migrate": "pnpm --filter @nexodesk/database migrate",
    "db:seed": "pnpm --filter @nexodesk/database seed",
    "db:studio": "pnpm --filter @nexodesk/database studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.22.0"
}
